<!DOCTYPE html>
<html>
    <head>
        <title>Nouveau paiement</title>
        <link rel="stylesheet" href="/stylesheets/style.css" />
    </head>
    <body>
        <p><a href="/payments">&larr; Paiements</a></p>
        <h1>Effectuer un paiement</h1>

        <% if (orders.length === 0) { %>
            <p>Aucune commande en attente de paiement. <a href="/orders/new">Passez une commande</a> d'abord.</p>
        <% } else { %>
            <form action="/payments/add" method="POST">
                <label for="orderId">Commande</label>
                <select id="orderId" name="orderId">
                    <% for (let order of orders) { %>
                        <option value="<%= order.id %>">
                            <%= order.bookTitle || order.bookId %> (x<%= order.quantity %>) - <%= order.customerName || 'Client inconnu' %>
                        </option>
                    <% } %>
                </select>

                <label for="amount">Montant (€)</label>
                <input type="number" id="amount" name="amount" step="0.01" min="0" required>

                <label for="method">Méthode</label>
                <select id="method" name="method">
                    <option value="CARD">Carte bancaire</option>
                    <option value="PAYPAL">PayPal</option>
                    <option value="TRANSFER">Virement</option>
                </select>

                <button type="submit">Payer</button>
            </form>
        <% } %>
    </body>
</html>
