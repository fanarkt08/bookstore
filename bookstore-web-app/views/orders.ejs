<!DOCTYPE html>
<html>
    <head>
        <title>Commandes</title>
        <link rel="stylesheet" href="/stylesheets/style.css" />
    </head>
    <body>
        <p><a href="/">&larr; Accueil</a></p>
        <h1>Commandes</h1>
        <table border="1" cellpadding="6" cellspacing="0">
            <thead>
                <tr>
                    <th>Livre</th>
                    <th>Client</th>
                    <th>Quantité</th>
                    <th>Statut</th>
                    <th>Créée le</th>
                </tr>
            </thead>
            <tbody>
                <% for (let order of orders) { %>
                    <tr>
                        <td><%= order.bookTitle || order.bookId %></td>
                        <td><%= order.customerName || '-' %></td>
                        <td><%= order.quantity %></td>
                        <td><%= order.status %></td>
                        <td><%= order.createdAt ? new Date(order.createdAt).toLocaleString() : '-' %></td>
                    </tr>
                <% } %>
                <% if (orders.length === 0) { %>
                    <tr><td colspan="5">Aucune commande pour le moment.</td></tr>
                <% } %>
            </tbody>
        </table>

        <p><a href="/orders/new">Passer une nouvelle commande</a></p>
    </body>
</html>
